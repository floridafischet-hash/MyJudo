NODE_ENV=development
PORT=3000
POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgresql://myjudo:change-me@localhost:5432/myjudo
APP_ORIGIN=https://localhost:18780
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
PASSWORD_PEPPER=replace-with-a-random-password-pepper
INITIAL_ADMIN_EMAIL=admin@example.invalid
INITIAL_ORGANIZATION_SLUG=my-judo-verein
INITIAL_ORGANIZATION_NAME=Mein Judo-Verein

# Online-Meeting-Links bei Terminen (Google Meet / Microsoft Teams / andere
# Anbieter) funktionieren bereits vollständig ohne OAuth: Berechtigte
# Benutzer hinterlegen einen vorhandenen https-Link manuell, er wird
# serverseitig validiert und nur berechtigten Teilnehmern angezeigt.
#
# Die folgenden Variablen sind NICHT implementiert und werden vom Code aktuell
# nirgends gelesen. Sie sind hier nur dokumentiert, falls später eine
# automatische Meeting-Erstellung über die Google Calendar API bzw. Microsoft
# Graph API ergänzt werden soll. Ohne diese Werte bleibt die manuelle
# Link-Funktion die einzige und vollständig nutzbare Variante.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT_ID=
