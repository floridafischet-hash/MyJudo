{
  "realm": "myjudo",
  "enabled": true,
  "displayName": "MyJudo",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "superuser",
        "description": "Coarse Keycloak entitlement; local Superuser role is additionally required"
      }
    ]
  },
  "clients": [
    {
      "clientId": "myjudo-client",
      "name": "MyJudo public client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "https://212.227.20.171:18780",
      "baseUrl": "https://212.227.20.171:18780/",
      "redirectUris": [
        "https://212.227.20.171:18780/auth.html",
        "http://localhost:*/auth.html",
        "myjudo://auth"
      ],
      "webOrigins": [
        "https://212.227.20.171:18780",
        "http://localhost:*"
      ],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "myjudo-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "myjudo-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "defaultClientScopes": ["web-origins", "acr", "basic", "roles", "profile", "email"]
    }
  ]
}
